// Cloudflare Workers (static assets) deployment config.
// Alternative to git-connected Pages: `npx wrangler deploy`
// after `npm run build`.
{
  "name": "website",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist/sundorf-me/browser",
    // Prerendered multi-page site: unmatched URLs get 404.html with a 404 status.
    // ("single-page-application" would serve index.html for everything - not wanted here.)
    "not_found_handling": "404-page"
  },
   "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
